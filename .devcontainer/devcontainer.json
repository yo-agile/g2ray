{
  "name": "@Kakoolnews",
  "build": {
    "dockerfile": "./Dockerfile",
    "context": "."
  },
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": false
    }
  },
  "postAttachCommand": "sudo -E /usr/local/bin/entrypoint.sh",
  "portsAttributes": {
    "443": {
      "label": "xray-vless",
      "protocol": "http",
      "onAutoForward": "silent"
    }
  },
  "forwardPorts": [443],
  "hostRequirements": {
    "cpus": 2
  }
}
