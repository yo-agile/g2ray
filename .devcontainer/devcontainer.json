{
  "name": "g2ray-vless",
  "build": {
    "dockerfile": "./Dockerfile",
    "context": "."
  },
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": false
    }
  },
  "postCreateCommand": "bash /workspaces/setup.sh",
  "portsAttributes": {
    "10000": {
      "label": "Xray",
      "protocol": "http",
      "onAutoForward": "silent"
    }
  },
  "forwardPorts": [10000],
  "hostRequirements": {
    "cpus": 2
  }
}
